{
  "$schema": "https://example.local/phaser-starter-hero-assets.schema.json",
  "version": 1,
  "id": "hero-v2",
  "characterId": "bottari-quest-backpack",
  "description": "Bottari hand-drawn backpack platformer character assets generated from the local Bottari renderer.",
  "direction": "w",
  "frameWidth": 256,
  "frameHeight": 256,
  "margin": 0,
  "spacing": 0,
  "anchor": {
    "x": 0.5,
    "y": 0.99609375
  },
  "anchorPixels": {
    "x": 128,
    "y": 255
  },
  "source": {
    "generator": "scripts/generate-bottari-hero-assets.py",
    "style": "bottari-illust",
    "notes": "Main-card-style black sketch lines, 3/4 white backpack body, large orange polka-dot bundle, transparent sprite sheets."
  },
  "images": [
    {
      "id": "hero-v2-anchor-w",
      "kind": "image",
      "path": "anchor-w.png",
      "url": "/assets/hero-v2/anchor-w.png",
      "width": 1024,
      "height": 1024,
      "usage": "Bottari west-facing transparent anchor reference"
    },
    {
      "id": "hero-v2-anchor-n",
      "kind": "image",
      "path": "anchor-n.png",
      "url": "/assets/hero-v2/anchor-n.png",
      "width": 1024,
      "height": 1024,
      "usage": "Bottari back-view transparent anchor reference for portal entry"
    }
  ],
  "animations": [
    {
      "id": "hero-v2-idle",
      "action": "idle",
      "path": "idle.png",
      "url": "/assets/hero-v2/idle.png",
      "preview": "idle-preview.gif",
      "previewUrl": "/assets/hero-v2/idle-preview.gif",
      "frames": 12,
      "columns": 4,
      "rows": 4,
      "frameRate": 6,
      "repeat": -1,
      "source": "bottariProceduralRenderer"
    },
    {
      "id": "hero-v2-walk",
      "action": "walk",
      "path": "walk.png",
      "url": "/assets/hero-v2/walk.png",
      "preview": "walk-preview.gif",
      "previewUrl": "/assets/hero-v2/walk-preview.gif",
      "frames": 8,
      "columns": 4,
      "rows": 4,
      "frameRate": 7,
      "repeat": -1,
      "source": "bottariProceduralRenderer"
    },
    {
      "id": "hero-v2-enter-portal",
      "action": "enter-portal",
      "engineAction": "walk_forward",
      "direction": "n",
      "path": "enter-portal.png",
      "url": "/assets/hero-v2/enter-portal.png",
